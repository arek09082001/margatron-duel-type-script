# The game currently runs entirely in the browser, so every knob has to be a
# NEXT_PUBLIC_* variable to reach the client bundle. All of them are optional —
# the defaults in `src/game/config.ts` match the old `config/game.php`.

NEXT_PUBLIC_APP_VERSION=0.2.0

# Action points
NEXT_PUBLIC_GAME_ACTION_POINT_REGENERATION_SECONDS=60
NEXT_PUBLIC_GAME_ACTION_POINT_REGENERATION_LIMIT=20

# Fights per expedition into an expowisko before "Wyprawa zakończona"
NEXT_PUBLIC_GAME_EXPEDITION_FIGHTS=20

# Tavern rest
NEXT_PUBLIC_GAME_REST_ONE_MINUTE_SECONDS=60
NEXT_PUBLIC_GAME_REST_FIVE_MINUTES_SECONDS=300
NEXT_PUBLIC_GAME_REST_INSTANT_GOLD_PRICE=500

# --- Supabase (not wired up yet, see docs/SUPABASE.md) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

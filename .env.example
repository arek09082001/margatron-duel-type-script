# Database (Supabase → Connect). Both are required.
# Pooled connection, port 6543 — used at runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection, port 5432 — used by migrations.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Optional game balance (all have sensible defaults) ---
# NEXT_PUBLIC_APP_VERSION=0.3.0
# NEXT_PUBLIC_GAME_ACTION_POINT_REGENERATION_SECONDS=60
# NEXT_PUBLIC_GAME_ACTION_POINT_REGENERATION_LIMIT=20
# NEXT_PUBLIC_GAME_EXPEDITION_FIGHTS=20
# NEXT_PUBLIC_GAME_REST_ONE_MINUTE_SECONDS=60
# NEXT_PUBLIC_GAME_REST_FIVE_MINUTES_SECONDS=300
# NEXT_PUBLIC_GAME_REST_INSTANT_GOLD_PRICE=500
